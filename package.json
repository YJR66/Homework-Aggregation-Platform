{
  "name": "homework-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地优先的四平台作业清单",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "setup:ocr": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ocr.ps1"
  },
  "dependencies": { "playwright": "^1.55.0" }
}
